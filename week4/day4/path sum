class Solution {
    public boolean hasPathSum(TreeNode root, int targetSum) {
        int sum =0;
      return ps(root,targetSum,sum);  
    }
    public boolean ps(TreeNode root , int ts , int sum){
        if(root==null){
            return false;
        }
        sum+=root.val;
        if(root.left==null && root.right==null){
            return sum==ts;
        }
        return ps(root.left,ts,sum) || ps(root.right,ts,sum);
    }
}
