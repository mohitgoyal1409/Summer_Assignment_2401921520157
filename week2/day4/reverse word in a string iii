class Solution {
public:
    string reverseWords(string s) {
        int n = s.length();
        stack<char>st;
        string ans="";
        int i=0;
        while(i<n) {
            if(s[i]!=' ') {
                st.push(s[i]);
            }
            else {
                while(!(st.empty())) {
                    char element = st.top();
                    st.pop();
                    ans.push_back(element);
                }
                ans.push_back(' ');
            }
            i++;
        }
        while(!(st.empty())) {
            char element = st.top();
            st.pop();
            ans.push_back(element);
        }
        return ans;
    }
};
