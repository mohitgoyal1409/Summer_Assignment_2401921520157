class Solution {
   
public:
    int strStr(string haystack, string needle) {
        int n = haystack.size();
        int m = needle.size();

       if(n<m) {
        return -1;
       }       
       string s = "";
        for(int i = 0;i<m;i++) {
              s.push_back(haystack[i]);
        }

        if(needle==s) {
            return 0;
        }

       for(int i = m;i<n;i++) {
              s.push_back(haystack[i]);
              s.erase(0,1);
        if(needle==s) {
            return i-m+1;
        }
        }
        return -1;
    }
};
