class Solution {
public:
    bool repeatedSubstringPattern(string s) {
         string newstr = s + s;
         newstr.erase(0,1);
         newstr.erase(newstr.size()-1, 1);

         if(newstr.find(s) != string::npos) {
            return true;
         }
         else {
            return false;
         }
    }
};
