class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        ListNode *temp=head,*prev=NULL;
        int count=0;
        while(temp!=NULL) {
            count++;
            temp=temp->next;
        }
        if(head==NULL) {
            return head;
        }
        else if( count==1 && n==1) {
            delete(head);
            return NULL;
        }

        n=count-n;
        if(n==0){
            head=head->next;
            return head;
        }
        temp=head;
        int i=0;
        while(i<n) {
            prev=temp;
            temp=temp->next;
            i++;
        }
        prev->next=temp->next;
        delete(temp);
        return head;
    }
};
